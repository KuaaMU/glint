{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glint",
  "version": "0.1.0",
  "identifier": "com.glint.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Glint",
        "label": "hud",
        "width": 440,
        "height": 380,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "minWidth": 320,
        "minHeight": 240,
        "maxWidth": 800,
        "maxHeight": 900,
        "shadow": false,
        "visible": false
      },
      {
        "title": "Glint 偏好设置",
        "label": "preferences",
        "url": "preferences.html",
        "width": 620,
        "height": 700,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "title": "Glint 截屏透视",
        "label": "snipping",
        "url": "snipping.html",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
